# ==============================================================================
# TRUSTLENS v1.0.0 — Environment Configuration Template
# ==============================================================================
# Copy this template to `server/.env` and update the placeholder values.
#
# IMPORTANT SECURITY RULES:
# 1. Never commit `server/.env` to source control. It is ignored by `.gitignore`.
# 2. In production (NODE_ENV=production):
#    - JWT_SECRET must be at least 32 characters long. Startup aborts if invalid.
#    - MONGODB_URI must be set to a valid MongoDB connection string.
#    - PORT must be a valid integer between 1 and 65535.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Server Settings
# ------------------------------------------------------------------------------
# Port for the Express REST API and static frontend server (default: 4000)
PORT=4000

# Application environment ('development', 'production', or 'test')
NODE_ENV=development

# Reverse Proxy Trust Configuration
# Set to 'true' if running behind Nginx, Cloudflare, AWS ALB, or Heroku
# Values: 'true', 'false', 'loopback', or hop count (e.g., 1)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. Database Connections (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Primary database connection string for production and development
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trustlens?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trustlens?retryWrites=true&w=majority

# Optional: Dedicated Test Database URI override
# If omitted during tests, the system automatically rewrites the path to `trustlens_test`
# to guarantee that production data is never touched during automated testing.
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trustlens_test?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JSON Web Tokens (JWT)
# MUST be at least 32 characters in production. If missing/short, auth endpoints are disabled.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# JWT token expiration window (e.g. '2h', '7d', '24h')
JWT_EXPIRES_IN=2h

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins for cross-origin browser requests
# If left empty, all cross-origin requests are denied (same-origin policy enforced)
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 5. External Threat Feeds Synchronization
# ------------------------------------------------------------------------------
# Enable automatic background synchronization of URLhaus & OpenPhish feeds
# Values: 'true' or 'false' (default: false)
ENABLE_BACKGROUND_FEED_SYNC=false

# Sync interval in hours (default: 6 hours)
FEED_SYNC_INTERVAL_HOURS=6

# ------------------------------------------------------------------------------
# 6. Administrator Account Seeding (Optional - used by npm run seed:admin)
# ------------------------------------------------------------------------------
# Email address for the seeded administrator account
ADMIN_EMAIL=admin@example.com

# Password for the seeded administrator account (must be at least 12 characters)
ADMIN_PASSWORD=replace_with_secure_admin_password_12_chars
